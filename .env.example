GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
RESEND_API_KEY=
CONTACT_TO_EMAIL=hanyjiang@gmail.com
CONTACT_FROM_EMAIL="Hany Jiang <onboarding@resend.dev>"

# Canonical site URL (used for sitemap, robots, and access magic-link URLs)
NEXT_PUBLIC_SITE_URL=https://hanyjiang.com

# Recruiter access gate (courses/grades + resume PDF)
# Visitors unlock by leaving a short message; it emails CONTACT_TO_EMAIL and
# sets a signed access cookie immediately.
# Required: a long random secret that signs the access cookie.
ACCESS_SECRET=
# Optional: restrict who unlocks. Comma-separated exact emails and/or @domain
# suffixes (e.g. "jane@acme.com,@acme.com"). Empty = anyone who leaves a message
# unlocks (soft gate + lead capture). Uses RESEND_* above to notify you.
ACCESS_ALLOWED_EMAILS=
